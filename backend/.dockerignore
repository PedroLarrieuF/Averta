# =============================================================================
# AvertaSaaS - Docker Ignore
# Optimizes build context for faster builds and smaller images
# =============================================================================

# Git
.git
.gitignore
.github

# CI/CD
.github/workflows/*

# Documentation
*.md
docs/
README*

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.pyre/
*.egg-info/
dist/
build/
pip-wheel-metadata/

# Virtual environments
venv/
env/
.env
.env.local
.env.*.local

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
tests/
*.test.py
*_test.py
test_*.py
conftest.py

# Logs
*.log
logs/

# Database
*.sqlite
*.db
prisma/migrations/.migration_lock.toml

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Terraform (if in backend)
*.tfstate
*.tfstate.*
*.tfvars
.terraform/

# Secrets (never copy to image)
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Large data files
*.csv
*.json
*.xml
!pyproject.toml
!poetry.lock
!prisma/schema.prisma

# Frontend (if monorepo)
frontend/