// Averta SaaS - Freight Audit with Success-Based Billing
// Prisma Schema for PostgreSQL (shared with Python backend via Prisma Client Python)

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  output               = "../generated/prisma"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  AUDITOR
  MANAGER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

enum DocumentType {
  CTE
  NFE
  CTE_COMPLEMENTAR
  NFE_COMPLEMENTAR
  INVOICE
  SPREADSHEET
  CONTRACT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum DiscrepancyType {
  ICMS_DIFFERENTIAL
  ICMS_FCP
  ICMS_ST
  FREIGHT_WEIGHT_VALUE
  FREIGHT_CUBAGE
  REDESPACHO
  TOLL_PLAZA
  AD_VALOREM
  GRIS
  SICOBAN_TABLE
  COMPLEMENTARY_CTE
  PESO_REAL_VS_FATURADO
  VALOR_MINIMO_FRETE
  OTHER
}

enum DiscrepancyStatus {
  DETECTED
  OPEN
  IN_REVIEW
  CONTESTED
  APPROVED
  REJECTED
  PAID
  CLOSED
}

enum ContestStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  NEGOTIATING
  ACCEPTED
  PARTIAL
  REJECTED
  EXPIRED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum PricingModel {
  FIXED
  PROGRESSIVE
}

enum NotificationType {
  DISCREPANCY_FOUND
  CONTEST_APPROVED
  CONTEST_SENT
  CONTEST_RESPONSE
  RECOVERY_CONFIRMED
  WEEKLY_REPORT
  SYSTEM_ALERT
  CONTRACT_EXPIRING
  WELCOME
  PASSWORD_RESET
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  fullName      String
  role          UserRole     @default(CLIENT)
  status        UserStatus   @default(PENDING)
  avatarUrl     String?
  lastLoginAt   DateTime?
  companyId     String
  company       Company      @relation("CompanyUsers", fields: [companyId], references: [id])
  clientId      String?      @unique
  client        Client?      @relation("ClientUser", fields: [clientId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([companyId])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  tradeName     String?
  cnpj          String   @unique
  stateReg      String?
  municipalReg  String?
  address       Json?
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  settings      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]           @relation("CompanyUsers")
  clients       Client[]         @relation("CompanyClients")
  contracts     Contract[]       @relation("CompanyContracts")
  carriers      Carrier[]        @relation("CompanyCarriers")
  branches      Branch[]         @relation("CompanyBranches")
  documents     Document[]       @relation("CompanyDocuments")
  discrepancies Discrepancy[]    @relation("CompanyDiscrepancies")
  contests      Contest[]        @relation("CompanyContests")
  auditLogs     AuditLog[]

  @@index([cnpj])
  @@index([isActive])
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation("CompanyClients", fields: [companyId], references: [id])
  userId          String?  @unique
  user            User?    @relation("ClientUser")
  name            String
  tradeName       String?
  cnpj            String   @unique
  stateReg        String?
  email           String
  phone           String?
  address         Json?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  settings        Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches        Branch[]
  documents       Document[]
  contracts       Contract[]
  discrepancies   Discrepancy[]
  contests        Contest[]
  notifications   Notification[]

  @@index([companyId])
  @@index([cnpj])
  @@index([isActive])
}

model Branch {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation("CompanyBranches", fields: [companyId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  name          String
  code          String
  cnpj          String?
  address       Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents     Document[]
  discrepancies Discrepancy[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([clientId])
}

model Carrier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation("CompanyCarriers", fields: [companyId], references: [id])
  name          String
  tradeName     String?
  cnpj          String   @unique
  stateReg      String?
  address       Json?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  bankInfo      Json?
  settings      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts     Contract[]
  documents     Document[]
  discrepancies Discrepancy[]
  contests      Contest[]

  @@index([companyId])
  @@index([cnpj])
  @@index([isActive])
}

// ============================================
// CONTRACTS & TABLES
// ============================================

model Contract {
  id                    String         @id @default(cuid())
  companyId             String
  company               Company        @relation("CompanyContracts", fields: [companyId], references: [id])
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id])
  carrierId             String
  carrier               Carrier        @relation(fields: [carrierId], references: [id])
  number                String
  description           String?
  status                ContractStatus @default(PENDING)
  startDate             DateTime
  endDate               DateTime?
  successFeePct         Float          @default(25)
  minRecovery           Float?
  currency              String         @default("BRL")
  terms                 Json?
  metadata              Json?
  // Progressive pricing fields
  pricingModel          PricingModel   @default(FIXED)
  progressiveStartDate  DateTime?      // When progressive pricing starts (defaults to startDate)
  progressiveMonth1Pct  Float?         @default(5)  // First month percentage
  progressiveMonth2Pct  Float?         @default(10) // Second month onwards percentage
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tables                FreightTable[]
  documents             Document[]
  discrepancies         Discrepancy[]
  contests              Contest[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([carrierId])
  @@index([status])
  @@index([pricingModel])
}

model FreightTable {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name          String
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  description   String?
  rules         Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contractId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
}

// ============================================
// DOCUMENTS & PROCESSING
// ============================================

model Document {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation("CompanyDocuments", fields: [companyId], references: [id])
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  carrierId       String?
  carrier         Carrier?       @relation(fields: [carrierId], references: [id])
  contractId      String?
  contract        Contract?      @relation(fields: [contractId], references: [id])
  type            DocumentType
  status          DocumentStatus @default(UPLOADED)
  originalName    String
  storedName      String
  s3Key           String         @unique
  s3Bucket        String
  mimeType        String
  fileSize        Int
  parsedData      Json?
  rawXml          String?
  accessKey       String?        @unique
  issueDate       DateTime?
  totalValue      Float?
  freightValue    Float?
  icmsValue       Float?
  weight          Float?
  volume          Float?
  errorMessage    String?
  processingTime  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  processedAt     DateTime?

  discrepancies   Discrepancy[]

  @@index([companyId])
  @@index([clientId])
  @@index([carrierId])
  @@index([contractId])
  @@index([type])
  @@index([status])
  @@index([accessKey])
  @@index([issueDate])
  @@index([createdAt])
}

model Discrepancy {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation("CompanyDiscrepancies", fields: [companyId], references: [id])
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  carrierId        String?
  carrier          Carrier?           @relation(fields: [carrierId], references: [id])
  contractId       String?
  contract         Contract?          @relation(fields: [contractId], references: [id])
  documentId       String
  document         Document           @relation(fields: [documentId], references: [id])
  type             DiscrepancyType
  status           DiscrepancyStatus  @default(DETECTED)
  ruleCode         String
  ruleVersion      Int                @default(1)
  ruleDescription  String
  expectedValue    Float
  actualValue      Float
  difference       Float
  differencePct    Float
  currency         String             @default("BRL")
  details          Json?
  evidence         Json?
  notes            String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  contestItems     ContestItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([carrierId])
  @@index([contractId])
  @@index([documentId])
  @@index([type])
  @@index([status])
  @@index([ruleCode])
  @@index([createdAt])
}

// ============================================
// CONTESTS & RECOVERY
// ============================================

model Contest {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation("CompanyContests", fields: [companyId], references: [id])
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  carrierId       String
  carrier         Carrier        @relation(fields: [carrierId], references: [id])
  contractId      String?
  contract        Contract?      @relation(fields: [contractId], references: [id])
  number          String
  status          ContestStatus  @default(DRAFT)
  totalExpected   Float          @default(0)
  totalRecovered  Float          @default(0)
  successFeePct   Float
  successFeeValue Float          @default(0)
  netRecovery     Float          @default(0)
  sentAt          DateTime?
  acknowledgedAt  DateTime?
  respondedAt     DateTime?
  resolvedAt      DateTime?
  expiredAt       DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           ContestItem[]
  communications  Communication[]
  payments        Payment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([carrierId])
  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

model ContestItem {
  id              String        @id @default(cuid())
  contestId       String
  contest         Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  discrepancyId   String
  discrepancy     Discrepancy   @relation(fields: [discrepancyId], references: [id])
  expectedValue   Float
  contestedValue  Float
  recoveredValue  Float         @default(0)
  status          ContestStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments        Payment[]     @relation("ContestItemPayments")

  @@index([contestId])
  @@index([discrepancyId])
  @@index([status])
}

model Communication {
  id          String   @id @default(cuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  type        String
  direction   String
  subject     String?
  content     String
  attachments Json?
  sentById    String?
  sentAt      DateTime @default(now())
  readAt      DateTime?

  @@index([contestId])
  @@index([sentAt])
}

model Payment {
  id          String   @id @default(cuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  itemId      String?
  item        ContestItem? @relation("ContestItemPayments", fields: [itemId], references: [id])
  type        String
  amount      Float
  currency    String   @default("BRL")
  status      String
  reference   String?
  paidAt      DateTime?
  confirmedAt DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([contestId])
  @@index([status])
  @@index([paidAt])
}

// ============================================
// AUDIT & NOTIFICATIONS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entityType String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  sentAt    DateTime         @default(now())
  channels  String[]

  @@index([clientId])
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([sentAt])
}

// ============================================
// SYSTEM CONFIG
// ============================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// RULES ENGINE
// ============================================

model Rule {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  type          DiscrepancyType
  severity      String
  configJson    Json             @default("{}")
  version       Int              @default(1)
  isActive      Boolean          @default(true)
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([code])
  @@index([type])
  @@index([isActive])
}