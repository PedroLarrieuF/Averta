# AvertaSaaS - Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=averta

# Redis
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=averta-documents

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long-here
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-min-32-chars-long

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (Mailhog for dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@averta.com
SMTP_TLS=false

# SendGrid (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@averta.com
SENDGRID_FROM_NAME="Averta Auditoria"

# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Flower Auth (optional)
FLOWER_USER=admin
FLOWER_PASSWORD=admin