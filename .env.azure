# AvertaSaaS - Azure Development Environment Variables
# Copy this file to .env and customize as needed

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=averta

# Redis
REDIS_PASSWORD=

# Azure Blob Storage (Azurite emulator)
AZURE_STORAGE_CONTAINER_NAME=averta-documents

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=iF8OHf4KHSHzXVE8t5wU+u9cOA4eA+5UpaPp6nxmNjY=
JWT_REFRESH_SECRET_KEY=iF8OHf4KHSHzXVE8t5wU+u9cOA4eA+5UpaPp6nxmNjY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (Mailhog for dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@averta.com
SMTP_TLS=false

# SendGrid (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@averta.com
SENDGRID_FROM_NAME="Averta Auditoria"

# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Flower Auth (optional)
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# Azure Key Vault (disabled for local dev)
AZURE_KEYVAULT_ENABLED=false
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_PREFIX=averta
AZURE_KEYVAULT_ENVIRONMENT=development
AZURE_KEYVAULT_CACHE_TTL=300